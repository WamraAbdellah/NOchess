# NOchess Environment Variables
# Copy this file to .env and adjust values

# Security
JWT_SECRET=change_this_to_a_strong_random_secret_in_production

# Database (override defaults from docker-compose)
POSTGRES_DB=nochess
POSTGRES_USER=nochess
POSTGRES_PASSWORD=nochess_password

# Optional: External URL (if deployed on a server)
# FRONTEND_URL=https://yourdomain.com
