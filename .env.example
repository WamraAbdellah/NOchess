# NOchess Environment Variables
# Copy this file to .env and fill in EVERY value before running docker compose.
# The app refuses to start if any secret is missing.
#
# Generate each secret with:   openssl rand -hex 32
# (hex output is safe to use inside connection URLs)

# Security — at least 32 random characters
JWT_SECRET=

# Database
POSTGRES_DB=nochess
POSTGRES_USER=nochess
POSTGRES_PASSWORD=

# Redis
REDIS_PASSWORD=

# Public URL of the site (used for CORS). Use https:// once you have TLS set up.
FRONTEND_URL=http://localhost
